{
  "name": "copilot-mcp-local-remote-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "22.14.0",
    "npm": "10.9.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run plugin:build && npm run plugin:validate && npm run plugin:compare && npm run test:discovery-parity && npm run experiment:verify-manifest && npm run verify:no-secrets && npm run verify:boundaries && npm run docs:check",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contract": "vitest run test/contract",
    "test:negative": "vitest run test/negative",
    "plugin:build": "npm run build && node scripts/build-plugin.mjs",
    "plugin:validate": "node scripts/check-generated.mjs",
    "plugin:compare": "node scripts/compare-plugin.mjs",
    "test:discovery-parity": "node scripts/compare-discovery.mjs",
    "experiment:run": "npm run plugin:build && node scripts/run-comparison.mjs",
    "experiment:verify-manifest": "node scripts/verify-experiment-manifest.mjs",
    "verify:no-secrets": "node scripts/verify-no-secrets.mjs",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "video:prepare": "node scripts/render-video-report.mjs",
    "video:capture": "playwright test test/video",
    "video:verify": "node scripts/verify-videos.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "prettier": "3.8.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
